# Copy this file to .env.local and fill in values.
# .env.local is gitignored — never commit real secrets.

# Telegram Bot — contact form notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel — set a long random string for SESSION_SECRET
SESSION_SECRET=
# Initial password for the default "admin" user (used on first login)
ADMIN_INITIAL_PASSWORD=
