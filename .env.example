# Copy this file to .env.local and fill in values.
# .env.local is gitignored — never commit real secrets.

# Telegram Bot — contact form notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel — set a long random string for SESSION_SECRET
SESSION_SECRET=
# Initial password for the default "admin" user (used on first login)
ADMIN_INITIAL_PASSWORD=

# MongoDB Atlas — reviews & admin users storage
# Atlas → Database → Connect → Drivers → copy the connection string.
# IMPORTANT: if your database password contains special characters (@, :, /, %, etc.)
# they must be URL-encoded (e.g. "@" -> "%40") or the connection string will fail to parse.
MONGODB_URI=
MONGODB_DB='matrushakti-yog'

# Vercel Blob — review photo uploads
# Vercel dashboard → Storage → create a Blob store → connect it to this project.
BLOB_READ_WRITE_TOKEN=
